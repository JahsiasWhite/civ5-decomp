# /etc/c5d.env  (chmod 600, owned by root; read by systemd for c5d.service)
C5D_HOST=127.0.0.1
C5D_PORT=8765
C5D_PUBLIC_URL=https://c5d.example.org
C5D_DB=/var/lib/c5d/c5d.sqlite
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
C5D_SESSION_SECRET=
# GitHub OAuth app, callback https://c5d.example.org/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub logins allowed to push verify results (manage.py push)
C5D_ADMINS=
# never set C5D_DEV_AUTH here
